{
  "name": "optionspricing",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "dev:client": "bun run --cwd client dev",
    "typecheck": "tsc --noEmit && bun run --cwd client typecheck",
    "lint": "eslint .",
    "build": "bun run --cwd client build",
    "check": "bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
